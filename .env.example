# Copy this file to `.env` (gitignored) for local development.
# Never commit real credentials.

# Neon PostgreSQL connection string — used by db/ and scripts/ (node) and by
# /api/sql (Vercel Edge Function) at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Inlined into the browser bundle by Vite at build time. Must be set for the
# deployed app: src/lib/api.ts and src/lib/neonClient.ts throw when it is
# missing instead of falling back to a hardcoded connection string.
# (Vite also supports VITE_DATABASE_URL=${DATABASE_URL})
VITE_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# S3-compatible storage (Neon S3)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
VITE_AWS_ENDPOINT_URL_S3=
VITE_AWS_REGION=

# Auth
AUTH_URL=
JWKS_URL=
VITE_AUTH_URL=
VITE_JWKS_URL=
