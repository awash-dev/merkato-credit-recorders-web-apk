# Copy this file to `apk/.env` (gitignored, bundled as a Flutter asset and
# loaded by flutter_dotenv in lib/main.dart). Never commit real credentials.
#
# CI writes this file from the NEON_CONNECTION_STRING repository secret —
# see apk/.github/workflows/apk-ci.yml.

# Neon PostgreSQL connection string
NEON_CONNECTION_STRING=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional: Neon serverless SQL endpoints (used when present, otherwise the
# client falls back to the standard endpoints for your region).
NEON_REGION_ENDPOINT=https://ENDPOINT_ID.sql
NEON_DIRECT_ENDPOINT=https://ENDPOINT_ID-pooler.sql
